---
// swarm → server → client, with packets animating along each link.
// Horizontal on wide screens, vertical on phones.
---

<div class="flow" role="img" aria-label="BitTorrent swarm sends data to the deaddrop server, which never uploads. The server sends the files over an end-to-end encrypted iroh connection to the client, which verifies them. With --encrypt, the server also age-encrypts the files and the client decrypts them.">
	<div class="node">
		<div class="icon">🌐</div>
		<div class="name">BitTorrent swarm</div>
		<div class="sub">peers, trackers, DHT</div>
	</div>

	<div class="link one-way">
		<div class="track"><span class="pkt"></span><span class="pkt"></span><span class="pkt"></span></div>
		<div class="label">leech only<br /><em>never uploads</em></div>
	</div>

	<div class="node hot">
		<div class="icon">🖥️</div>
		<div class="name mono">deaddrop serve</div>
		<div class="sub">tears down the swarm · <span class="opt">--encrypt: age</span></div>
	</div>

	<div class="link sealed">
		<div class="track"><span class="pkt"></span><span class="pkt"></span><span class="pkt"></span></div>
		<div class="label">iroh · encrypted QUIC<br /><em>BLAKE3-verified</em></div>
	</div>

	<div class="node">
		<div class="icon">💻</div>
		<div class="name mono">deaddrop fetch</div>
		<div class="sub">verifies · <span class="opt">decrypts if needed</span></div>
	</div>
</div>

<style>
	.flow {
		display: grid;
		grid-template-columns: 1fr 1.1fr 1fr 1.1fr 1fr;
		align-items: center;
		gap: 0;
	}
	.node {
		border: 1px solid var(--line);
		background: var(--panel);
		border-radius: 14px;
		padding: 20px 14px;
		text-align: center;
		position: relative;
	}
	.node.hot {
		border-color: var(--lime-dim);
		box-shadow: 0 0 60px -20px rgb(163 230 53 / 0.45);
	}
	.icon {
		font-size: 1.7rem;
		line-height: 1;
		margin-bottom: 10px;
	}
	.name {
		font-weight: 600;
		color: var(--fg);
	}
	.mono {
		font-family: var(--mono);
		font-size: 0.92rem;
	}
	.sub {
		margin-top: 4px;
		font-size: 0.78rem;
		color: var(--muted);
	}
	.sub .opt {
		font-family: var(--mono);
		color: var(--lime-dim, var(--lime));
		white-space: nowrap;
	}
	.link {
		position: relative;
		padding: 0 6px;
		text-align: center;
	}
	.track {
		position: relative;
		height: 2px;
		background: repeating-linear-gradient(90deg, var(--line) 0 6px, transparent 6px 11px);
		overflow: visible;
	}
	.pkt {
		position: absolute;
		top: -3px;
		left: 0;
		width: 8px;
		height: 8px;
		border-radius: 2px;
		background: var(--lime);
		box-shadow: 0 0 10px var(--lime);
		animation: travel 2.4s linear infinite;
	}
	.pkt:nth-child(2) {
		animation-delay: 0.8s;
	}
	.pkt:nth-child(3) {
		animation-delay: 1.6s;
	}
	.one-way .pkt {
		background: #e3e7e1;
		box-shadow: 0 0 8px rgb(255 255 255 / 0.4);
	}
	.sealed .pkt {
		border-radius: 50%;
	}
	.label {
		margin-top: 12px;
		font-family: var(--mono);
		font-size: 0.72rem;
		color: var(--fg-2);
		line-height: 1.5;
	}
	.label em {
		font-style: normal;
		color: var(--muted);
	}
	@keyframes travel {
		from {
			left: 0;
			opacity: 0;
		}
		10% {
			opacity: 1;
		}
		90% {
			opacity: 1;
		}
		to {
			left: calc(100% - 8px);
			opacity: 0;
		}
	}
	@keyframes travel-y {
		from {
			top: 0;
			opacity: 0;
		}
		10% {
			opacity: 1;
		}
		90% {
			opacity: 1;
		}
		to {
			top: calc(100% - 8px);
			opacity: 0;
		}
	}
	@media (max-width: 760px) {
		.flow {
			grid-template-columns: 1fr;
			max-width: 340px;
			margin: 0 auto;
		}
		.link {
			display: grid;
			grid-template-columns: 1fr 1fr;
			align-items: center;
			height: 86px;
			padding: 0;
		}
		.track {
			width: 2px;
			height: 100%;
			justify-self: end;
			margin-right: -1px;
			background: repeating-linear-gradient(180deg, var(--line) 0 6px, transparent 6px 11px);
		}
		.pkt {
			left: -3px;
			animation-name: travel-y;
		}
		.label {
			margin: 0 0 0 16px;
			text-align: left;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.pkt {
			animation: none;
			left: calc(50% - 4px);
		}
		.pkt:nth-child(n + 2) {
			display: none;
		}
	}
</style>
