---
// Starlight's default <head>, plus noindex on the 404 page so search engines
// never index it under its /404/ canonical.
import Default from '@astrojs/starlight/components/Head.astro';

const is404 = Astro.locals.starlightRoute.id === '404';
---

<Default />
{is404 && <meta name="robots" content="noindex" />}
