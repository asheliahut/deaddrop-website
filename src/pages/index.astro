---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import Terminal from '../components/Terminal.astro';
import Flow from '../components/Flow.astro';
import logo from '../assets/logo.svg?raw';
import { GITHUB, RELEASES, TAGLINE, VERSION } from '../site';

const title = 'deaddrop: leech, encrypt, hand off, vanish';
const canonical = new URL('/', Astro.site).href;

const features = [
	{ icon: '🚫', title: 'Zero seeding', body: "Built on librqbit's <code>disable-upload</code>. No incoming BitTorrent listener, and the swarm session is torn down before serving starts." },
	{ icon: '🔐', title: 'End-to-end encrypted', body: 'Every file is <a href="https://age-encryption.org">age</a>-encrypted with a fresh per-torrent key that never touches the server\'s disk. File names are hidden too.' },
	{ icon: '🕳️', title: 'NAT-proof transfers', body: '<a href="https://iroh.computer">iroh</a> punches through NATs and falls back to relays, so neither side needs an open port.' },
	{ icon: '✅', title: 'Verified delivery', body: 'Every chunk is checked against its BLAKE3 hash. Tampering or a wrong key fails loudly. No partial file is left under its real name.' },
	{ icon: '💥', title: 'Single use by default', body: 'One client, one download, then the server shuts down, or wipes the data and waits for the next drop.' },
	{ icon: '🔄', title: 'Hot swaps', body: 'Point a running server at a new torrent with <code>deaddrop reset</code>. The old ticket dies, and the new one gets a new key.' },
	{ icon: '🔔', title: 'Notifications', body: 'Push tickets to Discord or any webhook, with per-notifier control over who also gets the key.' },
	{ icon: '🧩', title: 'Script friendly', body: '<code>&lt;ticket&gt; &lt;key&gt;</code> on stdout, everything else on stderr. TOML config, env vars, shell completions.' },
];

const steps = [
	{ n: '01', verb: 'Leech', body: 'The server downloads the torrent with uploading disabled. Nothing is seeded, ever.' },
	{ n: '02', verb: 'Seal', body: 'The swarm session stops. Each file is age-encrypted to a new key, and the plaintext is deleted.' },
	{ n: '03', verb: 'Drop', body: 'A ticket and a key are printed. The client connects peer to peer over iroh and pulls the ciphertext.' },
	{ n: '04', verb: 'Vanish', body: 'The client verifies and decrypts. The single-use server shuts down, or wipes the data and waits.' },
];

const install = [
	{
		id: 'linux',
		label: 'Linux',
		code: `VERSION=${VERSION}
TARGET=x86_64-unknown-linux-musl   # or aarch64-unknown-linux-musl, *-linux-gnu
curl -LO "${RELEASES}/download/$VERSION/deaddrop-$VERSION-$TARGET.tar.gz"
tar -xzf "deaddrop-$VERSION-$TARGET.tar.gz"
sudo install "deaddrop-$VERSION-$TARGET/deaddrop" /usr/local/bin/`,
	},
	{
		id: 'macos',
		label: 'macOS',
		code: `VERSION=${VERSION}
TARGET=aarch64-apple-darwin        # or x86_64-apple-darwin (Intel)
curl -LO "${RELEASES}/download/$VERSION/deaddrop-$VERSION-$TARGET.tar.gz"
tar -xzf "deaddrop-$VERSION-$TARGET.tar.gz"
sudo install "deaddrop-$VERSION-$TARGET/deaddrop" /usr/local/bin/`,
	},
	{
		id: 'windows',
		label: 'Windows',
		code: `$v = "${VERSION}"
$t = "x86_64-pc-windows-msvc"      # or aarch64-pc-windows-msvc
Invoke-WebRequest "${RELEASES}/download/$v/deaddrop-$v-$t.zip" -OutFile deaddrop.zip
Expand-Archive deaddrop.zip -DestinationPath .`,
	},
	{
		id: 'source',
		label: 'From source',
		code: `# needs a recent stable Rust toolchain
cargo install --locked --git ${GITHUB}`,
	},
];

const builtOn = [
	{ name: 'iroh', href: 'https://iroh.computer', what: 'P2P QUIC transport' },
	{ name: 'iroh-blobs', href: 'https://github.com/n0-computer/iroh-blobs', what: 'verified blob transfer' },
	{ name: 'librqbit', href: 'https://github.com/ikatson/rqbit', what: 'BitTorrent engine' },
	{ name: 'age', href: 'https://github.com/str4d/rage', what: 'file encryption' },
	{ name: 'clap', href: 'https://github.com/clap-rs/clap', what: 'command line' },
	{ name: 'tokio', href: 'https://tokio.rs', what: 'async runtime' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={TAGLINE} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta name="theme-color" content="#0b0d0c" />
		<meta name="color-scheme" content="dark" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={TAGLINE} />
		<meta property="og:image" content={new URL('/og.png', Astro.site).href} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="sitemap" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>

		<header class="nav">
			<div class="wrap nav-inner">
				<a class="brand" href="/" aria-label="deaddrop home">
					<span class="brand-mark" set:html={logo} />
					<span>deaddrop</span>
				</a>
				<nav aria-label="Primary">
					<a href="/docs/">Docs</a>
					<a href="/docs/quick-start/" class="hide-sm">Quick start</a>
					<a href="/docs/reference/cli/" class="hide-sm">Reference</a>
					<a href={GITHUB} class="gh" aria-label="deaddrop on GitHub">
						<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
						<span class="hide-sm">GitHub</span>
					</a>
				</nav>
			</div>
		</header>

		<main id="main">
			<!-- HERO -->
			<section class="hero">
				<div class="grid-bg" aria-hidden="true"></div>
				<div class="wrap hero-inner">
					<p class="eyebrow">
						<span class="pulse" aria-hidden="true"></span>
						open source · public domain · written in rust
					</p>
					<h1>
						Leech it. Lock it.<br />
						Drop it. <span class="strike">Leave a trace.</span><span class="lime">Leave nothing.</span>
					</h1>
					<p class="lede">{TAGLINE}</p>
					<div class="ctas">
						<a class="btn primary" href="/docs/quick-start/">Get started →</a>
						<a class="btn ghost" href={GITHUB}>
							<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"></path></svg>
							Star on GitHub
						</a>
					</div>
					<div class="oneliner">
						<code><span class="lime">$</span> cargo install --locked --git {GITHUB}</code>
						<button type="button" class="copy" data-copy={`cargo install --locked --git ${GITHUB}`} aria-label="Copy install command">copy</button>
					</div>
					<div class="hero-term">
						<Terminal />
					</div>
				</div>
			</section>

			<!-- HOW -->
			<section class="section" id="how">
				<div class="wrap">
					<p class="kicker">// how it works</p>
					<h2>A dead drop in two commands.</h2>
					<p class="section-lede">
						A server downloads a torrent <strong>without seeding it</strong>, encrypts the result, then hands the files to
						one client over <a href="https://iroh.computer">iroh</a>: peer-to-peer QUIC with NAT traversal and relay
						fallback.
					</p>
					<div class="flow-wrap"><Flow /></div>
					<ol class="steps">
						{
							steps.map((s) => (
								<li>
									<span class="step-n">{s.n}</span>
									<h3>{s.verb}</h3>
									<p>{s.body}</p>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<!-- FEATURES -->
			<section class="section alt" id="features">
				<div class="wrap">
					<p class="kicker">// features</p>
					<h2>Small tool. Sharp edges, on purpose.</h2>
					<div class="features">
						{
							features.map((f) => (
								<article class="feature">
									<div class="f-icon" aria-hidden="true">{f.icon}</div>
									<h3>{f.title}</h3>
									<p set:html={f.body} />
								</article>
							))
						}
					</div>
				</div>
			</section>

			<!-- WHAT THE WIRE SEES -->
			<section class="section" id="encryption">
				<div class="wrap split">
					<div>
						<p class="kicker">// what the wire sees</p>
						<h2>Even the names are redacted.</h2>
						<p class="section-lede">
							Only ciphertext goes into the blob store and over iroh. Collection entries are named <code>0</code>,
							<code>1</code>, <code>2</code>… and the real file names live in an encrypted manifest. The key exists
							only in the server's memory.
						</p>
						<p class="honest">
							<strong>What it doesn't hide:</strong> file sizes, file count, and the fact that a transfer happened.
							Plaintext exists on the server's disk while the torrent downloads.{' '}
							<a href="/docs/concepts/threat-model/">Read the threat model →</a>
						</p>
					</div>
					<div class="manifest" aria-label="Illustration: encrypted collection entries and their hidden names">
						<div class="m-head">
							<span>collection</span><span class="lime">deaddrop-manifest.age 🔒</span>
						</div>
						<ul>
							<li><span class="idx">0</span><span class="bar-red" style="--w: 78%"></span><span class="real">Season 1/E01.mkv</span></li>
							<li><span class="idx">1</span><span class="bar-red" style="--w: 64%"></span><span class="real">Season 1/E02.mkv</span></li>
							<li><span class="idx">2</span><span class="bar-red" style="--w: 41%"></span><span class="real">extras/notes.txt</span></li>
							<li><span class="idx">3</span><span class="bar-red" style="--w: 55%"></span><span class="real">cover.jpg</span></li>
						</ul>
						<p class="m-foot">hover or tap to decrypt: needs <code>AGE-SECRET-KEY-1…</code></p>
					</div>
				</div>
			</section>

			<!-- INSTALL -->
			<section class="section alt" id="install">
				<div class="wrap">
					<p class="kicker">// install</p>
					<h2>Grab a binary or build it.</h2>
					<p class="section-lede">
						Prebuilt binaries for Linux (gnu + musl, x86_64 + aarch64), macOS (Intel + Apple Silicon) and Windows (x86_64 +
						ARM) are attached to every <a href={RELEASES}>GitHub release</a>, with <code>SHA256SUMS</code>.
					</p>
					<div class="tabs" data-tabs>
						<div class="tablist" role="tablist" aria-label="Install method">
							{
								install.map((t, i) => (
									<button
										type="button"
										role="tab"
										id={`tab-${t.id}`}
										aria-controls={`panel-${t.id}`}
										aria-selected={i === 0 ? 'true' : 'false'}
										tabindex={i === 0 ? 0 : -1}
									>
										{t.label}
									</button>
								))
							}
						</div>
						{
							install.map((t, i) => (
								<div class="panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
									<pre><code>{t.code}</code></pre>
									<button type="button" class="copy" data-copy={t.code} aria-label={`Copy ${t.label} install commands`}>copy</button>
								</div>
							))
						}
					</div>
					<p class="install-more">
						Then: <a href="/docs/quick-start/">quick start</a> · <a href="/docs/guides/config/">config file</a> ·
						<a href="/docs/guides/completions/">shell completions</a>
					</p>
				</div>
			</section>

			<!-- BUILT ON -->
			<section class="section" id="built-on">
				<div class="wrap">
					<p class="kicker">// built on</p>
					<h2>Standing on good shoulders.</h2>
					<ul class="built">
						{
							builtOn.map((b) => (
								<li>
									<a href={b.href}>
										<span class="b-name">{b.name}</span>
										<span class="b-what">{b.what}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- CTA -->
			<section class="cta">
				<div class="wrap cta-inner">
					<h2>Read the docs. Then leave nothing behind.</h2>
					<div class="ctas">
						<a class="btn primary" href="/docs/">Documentation →</a>
						<a class="btn ghost" href={GITHUB}>View source</a>
						<a class="btn ghost" href={RELEASES}>Releases</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="foot">
			<div class="wrap foot-inner">
				<div>
					<a class="brand small" href="/"><span class="brand-mark" set:html={logo} />deaddrop</a>
					<p>Free and unencumbered software released into the <a href="https://unlicense.org">public domain</a>.</p>
					<p class="muted">Use it responsibly: only download and share content you have the right to.</p>
				</div>
				<nav aria-label="Footer">
					<div>
						<h4>Docs</h4>
						<a href="/docs/">Introduction</a>
						<a href="/docs/installation/">Installation</a>
						<a href="/docs/reference/cli/">CLI reference</a>
						<a href="/docs/concepts/encryption/">Encryption</a>
					</div>
					<div>
						<h4>Project</h4>
						<a href={GITHUB}>GitHub</a>
						<a href={RELEASES}>Releases</a>
						<a href={`${GITHUB}/issues`}>Issues</a>
						<a href="/docs/project/security/">Security</a>
					</div>
				</nav>
			</div>
		</footer>

		<script>
			// Copy buttons
			for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
				btn.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(btn.dataset.copy ?? '');
						btn.textContent = 'copied ✓';
					} catch {
						btn.textContent = 'press ⌘/Ctrl+C';
					}
					setTimeout(() => (btn.textContent = 'copy'), 1600);
				});
			}

			// Accessible tabs
			for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
				const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
				const select = (tab: HTMLButtonElement) => {
					for (const t of tabs) {
						const on = t === tab;
						t.setAttribute('aria-selected', String(on));
						t.tabIndex = on ? 0 : -1;
						const panel = document.getElementById(t.getAttribute('aria-controls')!);
						if (panel) panel.hidden = !on;
					}
				};
				tabs.forEach((tab, i) => {
					tab.addEventListener('click', () => select(tab));
					tab.addEventListener('keydown', (e) => {
						const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
						if (!d) return;
						const next = tabs[(i + d + tabs.length) % tabs.length];
						select(next);
						next.focus();
					});
				});
				// Default to the visitor's platform.
				const ua = navigator.userAgent;
				const guess = /Windows/.test(ua) ? 'windows' : /Mac OS X/.test(ua) && !/iPhone|iPad/.test(ua) ? 'macos' : /Linux/.test(ua) && !/Android/.test(ua) ? 'linux' : null;
				const tab = guess && tabs.find((t) => t.id === `tab-${guess}`);
				if (tab) select(tab);
			}

			// Tap to reveal on touch devices
			for (const li of document.querySelectorAll<HTMLElement>('.manifest li')) {
				li.tabIndex = 0;
				li.addEventListener('click', () => li.classList.toggle('open'));
			}
		</script>

		<style is:global>
			:root {
				--bg: #0b0d0c;
				--bg-2: #0f1211;
				--panel: #121614;
				--line: #232925;
				--fg: #f4f6f3;
				--fg-2: #c9cfc6;
				--muted: #828c7f;
				--lime: #a3e635;
				--lime-dim: #4d7c0f;
				--red: #f87171;
				--sans: 'Space Grotesk Variable', ui-sans-serif, system-ui, sans-serif;
				--mono: 'JetBrains Mono Variable', ui-monospace, SFMono-Regular, Menlo, monospace;
				color-scheme: dark;
			}
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}
			html {
				scroll-behavior: smooth;
			}
			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}
			}
			body {
				margin: 0;
				background: var(--bg);
				color: var(--fg-2);
				font-family: var(--sans);
				font-size: 17px;
				line-height: 1.6;
				-webkit-font-smoothing: antialiased;
				overflow-x: hidden;
			}
			a {
				color: var(--lime);
				text-decoration-color: rgb(163 230 53 / 0.35);
				text-underline-offset: 3px;
			}
			a:hover {
				text-decoration-color: currentColor;
			}
			code {
				font-family: var(--mono);
				font-size: 0.86em;
				color: var(--fg);
				background: rgb(255 255 255 / 0.06);
				padding: 0.1em 0.35em;
				border-radius: 4px;
			}
			h1,
			h2,
			h3,
			h4 {
				color: var(--fg);
				letter-spacing: -0.025em;
				line-height: 1.1;
				margin: 0;
			}
			:focus-visible {
				outline: 2px solid var(--lime);
				outline-offset: 3px;
				border-radius: 4px;
			}
			.wrap {
				width: min(1120px, 100% - 32px);
				margin-inline: auto;
			}
			.lime {
				color: var(--lime);
			}
			.muted {
				color: var(--muted);
			}
			.skip {
				position: absolute;
				left: -999px;
				top: 8px;
				background: var(--lime);
				color: #000;
				padding: 6px 12px;
				z-index: 100;
				border-radius: 6px;
			}
			.skip:focus {
				left: 8px;
			}

			/* NAV */
			.nav {
				position: sticky;
				top: 0;
				z-index: 50;
				backdrop-filter: blur(12px);
				background: rgb(11 13 12 / 0.72);
				border-bottom: 1px solid rgb(35 41 37 / 0.6);
			}
			.nav-inner {
				display: flex;
				align-items: center;
				justify-content: space-between;
				height: 60px;
			}
			.brand {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				font-family: var(--mono);
				font-weight: 700;
				font-size: 1.05rem;
				color: var(--fg);
				text-decoration: none;
				letter-spacing: -0.02em;
			}
			.brand-mark svg {
				width: 26px;
				height: 26px;
				display: block;
			}
			.brand.small .brand-mark svg {
				width: 20px;
				height: 20px;
			}
			.nav nav {
				display: flex;
				align-items: center;
				gap: 22px;
			}
			.nav nav a {
				color: var(--fg-2);
				text-decoration: none;
				font-size: 0.93rem;
			}
			.nav nav a:hover {
				color: var(--lime);
			}
			.nav .gh {
				display: inline-flex;
				align-items: center;
				gap: 7px;
				border: 1px solid var(--line);
				padding: 6px 12px;
				border-radius: 8px;
			}

			/* HERO */
			.hero {
				position: relative;
				padding: 88px 0 72px;
				overflow: hidden;
			}
			.grid-bg {
				position: absolute;
				inset: 0;
				background-image:
					linear-gradient(var(--line) 1px, transparent 1px),
					linear-gradient(90deg, var(--line) 1px, transparent 1px);
				background-size: 48px 48px;
				opacity: 0.35;
				mask-image: radial-gradient(ellipse 70% 55% at 50% 30%, #000 20%, transparent 75%);
			}
			.hero::after {
				content: '';
				position: absolute;
				left: 50%;
				top: -200px;
				width: 900px;
				height: 600px;
				transform: translateX(-50%);
				background: radial-gradient(closest-side, rgb(163 230 53 / 0.13), transparent);
				pointer-events: none;
			}
			.hero-inner {
				position: relative;
				z-index: 1;
				text-align: center;
			}
			.eyebrow {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				font-family: var(--mono);
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.16em;
				color: var(--muted);
				border: 1px solid var(--line);
				border-radius: 999px;
				padding: 6px 14px;
				margin: 0 0 28px;
				background: rgb(18 22 20 / 0.7);
			}
			.pulse {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: var(--lime);
				box-shadow: 0 0 0 0 rgb(163 230 53 / 0.6);
				animation: pulse 2s infinite;
			}
			@keyframes pulse {
				70% {
					box-shadow: 0 0 0 10px rgb(163 230 53 / 0);
				}
				100% {
					box-shadow: 0 0 0 0 rgb(163 230 53 / 0);
				}
			}
			h1 {
				font-size: clamp(2.5rem, 7.2vw, 5.4rem);
				font-weight: 700;
				line-height: 1;
				letter-spacing: -0.045em;
			}
			.strike {
				position: relative;
				color: var(--muted);
				margin-right: 0.25em;
				display: inline-block;
			}
			.strike::after {
				content: '';
				position: absolute;
				left: -2%;
				right: -2%;
				top: 52%;
				height: 0.12em;
				background: var(--red);
				transform-origin: left;
				animation: strike 0.6s 0.6s cubic-bezier(0.7, 0, 0.3, 1) both;
			}
			@keyframes strike {
				from {
					transform: scaleX(0);
				}
			}
			.hero h1 .lime {
				display: inline-block;
				animation: rise 0.6s 1.1s both;
			}
			@keyframes rise {
				from {
					opacity: 0;
					transform: translateY(0.2em);
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.pulse,
				.strike::after,
				.hero h1 .lime {
					animation: none;
				}
			}
			.lede {
				max-width: 640px;
				margin: 26px auto 0;
				font-size: clamp(1.05rem, 2vw, 1.25rem);
				color: var(--fg-2);
			}
			.ctas {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 12px;
				margin-top: 34px;
			}
			.btn {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				padding: 12px 22px;
				border-radius: 10px;
				font-weight: 600;
				font-size: 0.98rem;
				text-decoration: none;
				transition:
					transform 0.15s,
					background 0.15s,
					border-color 0.15s;
			}
			.btn:hover {
				transform: translateY(-1px);
			}
			.btn.primary {
				background: var(--lime);
				color: #0b0d0c;
			}
			.btn.primary:hover {
				background: #bef264;
			}
			.btn.ghost {
				color: var(--fg);
				border: 1px solid var(--line);
				background: rgb(18 22 20 / 0.6);
			}
			.btn.ghost:hover {
				border-color: var(--lime-dim);
			}
			.oneliner {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				max-width: 100%;
				margin-top: 22px;
				padding: 6px 6px 6px 14px;
				border: 1px dashed var(--line);
				border-radius: 10px;
				background: var(--bg-2);
			}
			.oneliner code {
				background: none;
				padding: 0;
				font-size: 0.8rem;
				color: var(--fg-2);
				overflow-x: auto;
				white-space: nowrap;
				scrollbar-width: none;
			}
			.copy {
				font-family: var(--mono);
				font-size: 0.72rem;
				color: var(--muted);
				background: var(--panel);
				border: 1px solid var(--line);
				border-radius: 6px;
				padding: 4px 10px;
				cursor: pointer;
				flex-shrink: 0;
			}
			.copy:hover {
				color: var(--lime);
				border-color: var(--lime-dim);
			}
			.hero-term {
				max-width: 980px;
				margin: 60px auto 0;
			}

			/* SECTIONS */
			.section {
				padding: 96px 0;
				border-top: 1px solid var(--line);
			}
			.section.alt {
				background: var(--bg-2);
			}
			.kicker {
				font-family: var(--mono);
				color: var(--lime);
				font-size: 0.82rem;
				margin: 0 0 12px;
			}
			h2 {
				font-size: clamp(1.9rem, 4.2vw, 2.9rem);
				font-weight: 700;
			}
			.section-lede {
				max-width: 680px;
				margin: 18px 0 0;
				font-size: 1.08rem;
			}
			.flow-wrap {
				margin: 56px 0 8px;
			}
			.steps {
				list-style: none;
				padding: 0;
				margin: 56px 0 0;
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1px;
				background: var(--line);
				border: 1px solid var(--line);
				border-radius: 14px;
				overflow: hidden;
			}
			.steps li {
				background: var(--bg);
				padding: 26px 22px;
			}
			.step-n {
				font-family: var(--mono);
				font-size: 0.78rem;
				color: var(--lime);
			}
			.steps h3 {
				font-size: 1.4rem;
				margin: 8px 0 8px;
			}
			.steps p {
				margin: 0;
				font-size: 0.95rem;
				color: var(--muted);
			}

			.features {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 16px;
				margin-top: 48px;
			}
			.feature {
				background: var(--panel);
				border: 1px solid var(--line);
				border-radius: 14px;
				padding: 24px 22px;
				transition:
					border-color 0.2s,
					transform 0.2s;
			}
			.feature:hover {
				border-color: var(--lime-dim);
				transform: translateY(-2px);
			}
			.f-icon {
				font-size: 1.5rem;
				margin-bottom: 14px;
			}
			.feature h3 {
				font-size: 1.12rem;
				margin-bottom: 8px;
			}
			.feature p {
				margin: 0;
				font-size: 0.93rem;
				color: var(--muted);
			}

			.split {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 64px;
				align-items: center;
			}
			.honest {
				margin-top: 22px;
				padding: 14px 18px;
				border-left: 3px solid var(--red);
				background: rgb(248 113 113 / 0.06);
				border-radius: 0 10px 10px 0;
				font-size: 0.95rem;
			}
			.manifest {
				font-family: var(--mono);
				font-size: 0.85rem;
				border: 1px solid var(--line);
				border-radius: 14px;
				background: var(--panel);
				overflow: hidden;
			}
			.m-head {
				display: flex;
				justify-content: space-between;
				gap: 12px;
				padding: 12px 18px;
				border-bottom: 1px solid var(--line);
				color: var(--muted);
				font-size: 0.75rem;
			}
			.manifest ul {
				list-style: none;
				margin: 0;
				padding: 10px 0;
			}
			.manifest li {
				position: relative;
				display: flex;
				align-items: center;
				gap: 16px;
				padding: 11px 18px;
				cursor: pointer;
			}
			.manifest li:hover,
			.manifest li:focus-visible {
				background: rgb(163 230 53 / 0.05);
			}
			.idx {
				width: 1.5em;
				color: var(--lime);
			}
			.bar-red {
				height: 0.95em;
				width: var(--w);
				background: var(--fg-2);
				border-radius: 2px;
				transition:
					width 0.35s ease,
					opacity 0.35s;
			}
			.real {
				position: absolute;
				left: calc(18px + 1.5em + 16px);
				color: var(--lime);
				opacity: 0;
				transition: opacity 0.35s;
				white-space: nowrap;
			}
			.manifest li:hover .bar-red,
			.manifest li:focus-visible .bar-red,
			.manifest li.open .bar-red {
				width: 0;
				opacity: 0;
			}
			.manifest li:hover .real,
			.manifest li:focus-visible .real,
			.manifest li.open .real {
				opacity: 1;
			}
			.m-foot {
				margin: 0;
				padding: 12px 18px;
				border-top: 1px solid var(--line);
				font-size: 0.72rem;
				color: var(--muted);
			}

			/* TABS */
			.tabs {
				margin-top: 40px;
				border: 1px solid var(--line);
				border-radius: 14px;
				overflow: hidden;
				background: var(--bg);
			}
			.tablist {
				display: flex;
				overflow-x: auto;
				border-bottom: 1px solid var(--line);
				background: var(--panel);
			}
			.tablist button {
				font: inherit;
				font-size: 0.92rem;
				color: var(--muted);
				background: none;
				border: 0;
				border-bottom: 2px solid transparent;
				padding: 12px 20px;
				cursor: pointer;
				white-space: nowrap;
			}
			.tablist button[aria-selected='true'] {
				color: var(--fg);
				border-bottom-color: var(--lime);
			}
			.panel {
				position: relative;
			}
			.panel pre {
				margin: 0;
				padding: 22px 24px;
				overflow-x: auto;
				font-size: 0.85rem;
				line-height: 1.7;
			}
			.panel pre code {
				background: none;
				padding: 0;
				color: var(--fg-2);
			}
			.panel .copy {
				position: absolute;
				top: 12px;
				right: 12px;
			}
			.install-more {
				margin-top: 20px;
				font-size: 0.95rem;
			}

			.built {
				list-style: none;
				padding: 0;
				margin: 40px 0 0;
				display: grid;
				grid-template-columns: repeat(6, 1fr);
				gap: 12px;
			}
			.built a {
				display: block;
				padding: 18px;
				border: 1px solid var(--line);
				border-radius: 12px;
				text-decoration: none;
				height: 100%;
				transition: border-color 0.2s;
			}
			.built a:hover {
				border-color: var(--lime-dim);
			}
			.b-name {
				display: block;
				font-family: var(--mono);
				font-weight: 600;
				color: var(--fg);
			}
			.b-what {
				font-size: 0.85rem;
				color: var(--muted);
			}

			.cta {
				padding: 110px 0;
				border-top: 1px solid var(--line);
				background:
					radial-gradient(ellipse 60% 80% at 50% 120%, rgb(163 230 53 / 0.16), transparent 70%),
					var(--bg);
				text-align: center;
			}

			.foot {
				border-top: 1px solid var(--line);
				padding: 48px 0 56px;
				font-size: 0.9rem;
			}
			.foot-inner {
				display: flex;
				justify-content: space-between;
				gap: 40px;
				flex-wrap: wrap;
			}
			.foot p {
				margin: 12px 0 0;
				max-width: 420px;
			}
			.foot nav {
				display: flex;
				gap: 64px;
			}
			.foot nav div {
				display: flex;
				flex-direction: column;
				gap: 8px;
			}
			.foot h4 {
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.14em;
				color: var(--muted);
				margin-bottom: 4px;
			}
			.foot nav a {
				color: var(--fg-2);
				text-decoration: none;
			}
			.foot nav a:hover {
				color: var(--lime);
			}

			@media (max-width: 960px) {
				.features {
					grid-template-columns: repeat(2, 1fr);
				}
				.steps {
					grid-template-columns: repeat(2, 1fr);
				}
				.built {
					grid-template-columns: repeat(3, 1fr);
				}
				.split {
					grid-template-columns: 1fr;
					gap: 40px;
				}
			}
			@media (max-width: 600px) {
				body {
					font-size: 16px;
				}
				.hide-sm {
					display: none;
				}
				.hero {
					padding: 56px 0 48px;
				}
				.eyebrow {
					letter-spacing: 0.08em;
					font-size: 0.66rem;
				}
				.section {
					padding: 68px 0;
				}
				.features,
				.steps {
					grid-template-columns: 1fr;
				}
				.built {
					grid-template-columns: repeat(2, 1fr);
				}
				.foot nav {
					gap: 40px;
				}
			}
		</style>
	</body>
</html>
